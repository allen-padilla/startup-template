# =============================================================================
# Application
# =============================================================================

# Public URL of the web application.
# Reserved: not yet read by application code or validated by @startup/env.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# =============================================================================
# Database
# =============================================================================

# Required. Matches the local Docker Compose PostgreSQL service.
DATABASE_URL=postgresql://startup:startup@localhost:5432/startup

# =============================================================================
# Authentication
# =============================================================================

# Required. Server-only secret of at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Required.
BETTER_AUTH_URL=http://localhost:3000


# =============================================================================
# Email
# =============================================================================

# Optional. Used only by @startup/email. Email is disabled when both are empty;
# setting only one fails validation. Both are server-only: never prefix them
# with NEXT_PUBLIC_. See docs/architecture/email.md.
# SMTP connection string (secret when it contains credentials). Percent-encode
# reserved characters in the username and password, for example @ as %40.
# The default points at the local Mailpit mail catcher started by pnpm db:up.
# Read captured messages at http://localhost:8025. Mailpit is for local
# development only: replace both values before deploying.
SMTP_URL=smtp://localhost:1025
# Sender address, either an address or "Display Name <address>".
EMAIL_FROM="Startup Template <no-reply@example.com>"


# =============================================================================
# Billing
# =============================================================================

# Optional locally. Billing endpoints return an error until configured.
# All values are server-only: never prefix them with NEXT_PUBLIC_.
# Use Stripe test-mode values (sk_test_..., whsec_..., price_...) in development.
STRIPE_SECRET_KEY=
# Signing secret for the /api/billing/webhook endpoint
# (`stripe listen --forward-to localhost:3000/api/billing/webhook` prints one).
STRIPE_WEBHOOK_SECRET=
# Stripe Price ID for the Pro monthly plan.
STRIPE_PRICE_PRO_MONTHLY=


# =============================================================================
# Decision models
# =============================================================================

# Optional. Used only by @startup/decision, which raises a configuration error
# when a decision is evaluated without them. Both are server-only: never prefix
# them with NEXT_PUBLIC_. See docs/architecture/decision-models.md.
# TypeSafe API key (secret), from your TypeSafe account.
TYPESAFE_API_KEY=
# TypeSafe model name. List the names available to your key with
# GET https://api.typesafe.ai/v1/models.
TYPESAFE_MODEL=


# =============================================================================
# Observability
# =============================================================================

# All observability is optional. When unset, Sentry and PostHog are disabled.

# PostHog (browser-visible).
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry DSN (browser-visible; used by client, server and edge runtimes).
# NEXT_PUBLIC_SENTRY_DSN=

# Sentry source-map upload (build/CI only). SENTRY_AUTH_TOKEN is a secret:
# never prefix it with NEXT_PUBLIC_ and never commit it.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
